# Flask Configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_SECRET_KEY=  # Flask secret key for session management
FLASK_CONFIG=development  # Config class selector (development/staging/production)

# LLM API Keys
ANTHROPIC_API_KEY=  # Anthropic Claude Opus 4.6 API key
OPENAI_API_KEY=  # OpenAI GPT-5 Mini API key
VOYAGE_API_KEY=  # Voyage AI embeddings API key

# Platform Services
ADMIN_SERVICE_URL=  # archie-service-admin REST API URL
SECRET_MANAGER_URL=  # archie-secret-manager service URL
MARKDOWN_SERVICE_URL=  # archie-service-markdown URL (Mermaid validation)

# Graph Database
NEO4J_URI=  # Neo4j Bolt connection URI (e.g., neo4j://localhost:7687)
NEO4J_USERNAME=  # Neo4j username
NEO4J_PASSWORD=  # Neo4j password
NEO4J_DATABASE=  # Neo4j database name

# Observability
LANGCHAIN_TRACING_V2=true  # Enable LangSmith tracing
LANGCHAIN_API_KEY=  # LangSmith API key
LANGSMITH_PROJECT=  # LangSmith project name

# Pub/Sub
PUBSUB_PROJECT_ID=  # Google Cloud project ID for Pub/Sub
PUBSUB_TOPIC=  # Pub/Sub topic name for notifications

# Storage
GCS_BUCKET_NAME=  # Google Cloud Storage bucket for document persistence
GCS_PROJECT_ID=  # GCS project ID

# Additional Configuration
LOG_LEVEL=INFO  # Application log level
ENVIRONMENT=development  # Environment identifier
SERVICE_NAME=reverse-document-generator  # Service name for logging/monitoring
