# =============================================================================
# Reverse Document Generator — Environment Variable Template
# =============================================================================
#
# Copy this file to `.env` and fill in the actual values:
#
#   cp .env.example .env
#
# IMPORTANT: Never commit the `.env` file to version control. It contains
# sensitive credentials. The `.gitignore` is configured to exclude `.env`.
#
# Variables are organized by category. Leave secret values empty in this
# template; provide sensible defaults where applicable.
# =============================================================================

# -----------------------------------------------------------------------------
# Flask Configuration
# -----------------------------------------------------------------------------

# WSGI entry point module for Flask CLI and Gunicorn
FLASK_APP=wsgi.py

# Flask environment mode (development / production)
FLASK_ENV=development

# Secret key used by Flask for session signing and CSRF protection.
# Generate a strong random value for production, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Configuration class selector — maps to app/config.py classes
# Valid values: development, staging, production
FLASK_CONFIG=development

# -----------------------------------------------------------------------------
# Category 1: LLM API Keys
# -----------------------------------------------------------------------------

# Anthropic API key for Claude Opus 4.6 (primary LLM for document authoring)
ANTHROPIC_API_KEY=

# OpenAI API key for GPT-5 Mini (secondary LLM for structured output)
OPENAI_API_KEY=

# Voyage AI API key for text embeddings used in semantic search
VOYAGE_API_KEY=

# -----------------------------------------------------------------------------
# Category 2: Platform Services
# -----------------------------------------------------------------------------

# archie-service-admin REST API base URL (repository metadata, storage)
ADMIN_SERVICE_URL=

# archie-secret-manager service URL (credential retrieval)
SECRET_MANAGER_URL=

# archie-service-markdown URL (Mermaid diagram validation endpoint)
# Endpoint used: POST /v1/mermaid/validate
MARKDOWN_SERVICE_URL=

# -----------------------------------------------------------------------------
# Category 3: Graph Database (Neo4j)
# -----------------------------------------------------------------------------

# Neo4j Bolt connection URI
# Example: neo4j://localhost:7687 or neo4j+s://your-instance.databases.neo4j.io
NEO4J_URI=

# Neo4j authentication credentials
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Neo4j database name (leave empty for default database)
NEO4J_DATABASE=

# -----------------------------------------------------------------------------
# Category 4: Observability (LangSmith)
# -----------------------------------------------------------------------------

# Enable LangSmith tracing for LLM execution monitoring
LANGCHAIN_TRACING_V2=true

# LangSmith API key for trace submission
LANGCHAIN_API_KEY=

# LangSmith project name for trace grouping
LANGSMITH_PROJECT=

# LangSmith API endpoint (optional — defaults to hosted LangSmith)
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# -----------------------------------------------------------------------------
# Category 5: Google Cloud Pub/Sub (Notifications)
# -----------------------------------------------------------------------------

# Google Cloud project ID for Pub/Sub messaging
PUBSUB_PROJECT_ID=

# Pub/Sub topic name for document generation status notifications
# Events published: IN_PROGRESS (per-section), DONE (completion)
PUBSUB_TOPIC=

# -----------------------------------------------------------------------------
# Category 6: Google Cloud Storage (Document Persistence)
# -----------------------------------------------------------------------------

# GCS bucket name for storing generated Technical Specification documents
GCS_BUCKET_NAME=

# GCS project ID (may differ from Pub/Sub project)
GCS_PROJECT_ID=

# -----------------------------------------------------------------------------
# Additional Application Configuration
# -----------------------------------------------------------------------------

# Application log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Environment identifier used in logging and monitoring labels
ENVIRONMENT=development

# Service name reported in logs and observability traces
SERVICE_NAME=reverse-document-generator
